# ── Production environment — copy to .env.prod, never commit real values ──────

# Database (local VPS postgres — not exposed externally)
DATABASE_URL=postgresql+asyncpg://legalapp:STRONG_PASS@localhost:5432/legalapp
REDIS_URL=redis://:REDIS_PASS@localhost:6379
REDIS_PASSWORD=STRONG_REDIS_PASS

# App
SECRET_KEY=generate-with-openssl-rand-hex-64
FRONTEND_URL=https://yourdomain.com
# In prod behind nginx, backend and frontend share the same domain
BACKEND_URL=https://yourdomain.com
DOMAIN=yourdomain.com

# OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI APIs
OPENAI_API_KEY=sk-...              # For Phase 1 embeddings + query embedding
DEEPSEEK_API_KEY=                  # Primary LLM
ANTHROPIC_API_KEY=sk-ant-...       # Premium tier (Claude Opus 4)

# LLM model names — update when DeepSeek V4 Flash releases
PRIMARY_LLM=deepseek-chat
PREMIUM_LLM=claude-opus-4-8

# Dev mode MUST be false in production
DEV_MODE=false

# Platform super-admin key (generate with: openssl rand -hex 32)
# Keep secret — grants cross-tenant visibility
PLATFORM_SECRET_KEY=

# Optional: separate vectorDB for CourtListener public_chunks (BGE-384).
# Leave empty to use the main DATABASE_URL.
VECTORDB_URL=

# OAuth callback URIs — must match exactly what you register in each provider:
#
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
#   Authorized redirect URI: https://yourdomain.com/api/auth/google/callback
#
# Microsoft Entra → App Registrations → your app → Authentication
#   Redirect URI (Web): https://yourdomain.com/api/auth/microsoft/callback
#   Supported account types: Accounts in any organizational directory + personal Microsoft accounts
#   API permissions: User.Read (delegated, granted)

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...            # Flat-seat subscription Price ID from Stripe Dashboard
STRIPE_SUCCESS_URL=https://yourdomain.com/billing?success=1
STRIPE_CANCEL_URL=https://yourdomain.com/billing?cancel=1

# Storage
UPLOAD_DIR=/data/legalapp/uploads
MAX_FILE_SIZE_MB=50

# ── VPS deployment (used by deploy_prod.sh) ───────────────────────────────────
VPS_HOST=your.vps.ip.address
VPS_USER=deploy
VPS_APP_DIR=/home/deploy/legalapp
VPS_SSH_PORT=22
VPS_DB_URL=postgresql+asyncpg://legalapp:STRONG_PASS@localhost:5432/legalapp
GIT_BRANCH=main

# ── On-prem (used by sync_to_vps.sh) ─────────────────────────────────────────
LOCAL_DB_URL=postgresql://legalapp:legalapp@localhost:5432/legalapp

# ── Jetson embedding cluster ──────────────────────────────────────────────────
JETSON_0_HOST=192.168.1.101
JETSON_1_HOST=192.168.1.102
JETSON_2_HOST=192.168.1.103
JETSON_USER=jetson
JETSON_SCRIPT_DIR=/home/jetson/legalapp/scripts
BATCH_SIZE=256
