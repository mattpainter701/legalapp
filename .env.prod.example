# Production environment template. Copy to `.env` on the Linux production host.
# The current Compose files load `.env`; never commit the populated file.

# Local production databases are private Compose services. Use service names,
# not localhost: localhost inside a container is that container itself.
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
CLARITY_APP_PASSWORD=CHANGE_ME_RUNTIME_PASSWORD
DATABASE_URL=postgresql+asyncpg://legalapp:CHANGE_ME_OWNER_PASSWORD@postgres:5432/legalapp
MIGRATOR_DATABASE_URL=postgresql+asyncpg://legalapp:CHANGE_ME_OWNER_PASSWORD@postgres:5432/legalapp
APP_DATABASE_URL=postgresql+asyncpg://clarity_app:CHANGE_ME_RUNTIME_PASSWORD@postgres:5432/legalapp
BACKEND_WORKERS=4
# Connection ceiling: (workers + the one scheduler) * (pool + overflow).
DATABASE_POOL_SIZE=8
DATABASE_MAX_OVERFLOW=8
DATABASE_POOL_TIMEOUT_SECONDS=15

# Docker-local Redis is private but still authenticated. Use rediss:// for an
# off-host managed Redis endpoint and update the Compose topology deliberately.
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# App
SECRET_KEY=CHANGE_ME_APPLICATION_SECRET
FRONTEND_URL=https://yourdomain.com
# In prod behind nginx, backend and frontend share the same domain
BACKEND_URL=https://yourdomain.com
DOMAIN=yourdomain.com
VITE_PUBLIC_SITE_URL=https://yourdomain.com
VITE_CONTACT_URL=mailto:operations@yourdomain.com
PUBLIC_SIGNUP_ENABLED=false
VITE_PUBLIC_SIGNUP_ENABLED=false
TRUSTED_PROXY_HOPS=1

# Outbound task assignment/reminder email. Deployment may remain disabled
# while credentials are being provisioned. Assigned tasks remain durable and
# usable, but their best-effort email alerts are logged as unavailable; explicit
# reminder requests fail clearly instead of pretending a message was sent.
# Before customer go-live, set true and supply a real authenticated SMTP account;
# the production check connects/authenticates only and never sends a message.
# Strict first-customer checks require true plus working credentials.
EMAIL_ENABLED=true
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@yourdomain.com

# Token encryption — for storing OAuth refresh tokens at rest (Fernet symmetric key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# During this release, keep the previous key as the compatibility value and use
# a distinct newest-first pair in TOKEN_ENCRYPTION_KEYS until rotation is proven.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEYS=

# OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
OFFICE_ASSISTANT_ENABLED=false
# Comma-separated WellPled tenant UUIDs. Leave empty to deny every tenant.
OFFICE_ASSISTANT_PILOT_TENANT_IDS=
OFFICE_ENTRA_CLIENT_ID=
OFFICE_ENTRA_API_AUDIENCE=
OFFICE_ENTRA_REQUIRED_SCOPE=office.access
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://yourdomain.com/api/integrations/zoom/callback
ZOOM_PHONE_REDIRECT_URI=https://yourdomain.com/api/integrations/zoom-phone/callback
# Zoom Phone requires a tenant-owned account-level OAuth app configured in
# Administration > Zoom. Shared platform/S2S credentials are intentionally not
# supported because they cannot be safely bound in a multi-tenant deployment.
# Enter the firm's exact Zoom Account ID in Administration > Zoom; that explicit
# binding avoids adding a Zoom user-profile scope. A token account is compared
# when present. Before use, a signed v3 event must match the app account and the
# pending grant must successfully fetch that exact call from Zoom.
ZOOM_PHONE_SCOPES=phone:read:list_call_logs:admin phone:read:call_log:admin
TEAMS_APP_ID=b7aef9aa-6b66-4cde-8cf8-4a251e2f8f22

# AI APIs
OPENAI_API_KEY=sk-...              # For Phase 1 embeddings + query embedding
DEEPSEEK_API_KEY=                  # Primary LLM
ANTHROPIC_API_KEY=sk-ant-...       # Premium tier (Claude Opus 4)

# LLM model names — update when DeepSeek V4 Flash releases
PRIMARY_LLM=deepseek-chat
PREMIUM_LLM=claude-opus-4-8

# LiteLLM Gateway — primary LLM router when enabled
LITELLM_ENABLED=true
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=CHANGE_ME_LITELLM_API_KEY
# Permanent encryption salt for LiteLLM database secrets. Generate once and
# retain across API-key rotations; changing it makes stored values unreadable.
LITELLM_SALT_KEY=CHANGE_ME_PERMANENT_LITELLM_SALT_KEY
LITELLM_DB_PASSWORD=CHANGE_ME_LITELLM_DB_PASSWORD
LITELLM_DATABASE_URL=postgresql://litellm:CHANGE_ME_LITELLM_DB_PASSWORD@litellm-postgres:5432/litellm
LITELLM_STANDARD_MODEL=clarity-standard
LITELLM_PREMIUM_MODEL=clarity-premium

# Dev mode MUST be false in production
DEV_MODE=false

# Platform operator authentication. Keep raw bootstrap credentials and the
# independent token-signing key in the production secret manager.
PLATFORM_TOKEN_SIGNING_KEY=
PLATFORM_BOOTSTRAP_CREDENTIALS_JSON=[]
PLATFORM_LEGACY_BOOTSTRAP_ENABLED=false
PLATFORM_SECRET_KEY=                  # Temporary legacy bridge only
PLATFORM_LEGACY_BOOTSTRAP_OPERATOR_ID=
PLATFORM_LEGACY_BOOTSTRAP_EXPIRES_AT=
PLATFORM_LEGACY_BOOTSTRAP_MAX_SCOPES=platform:read

# CourtListener MCP/vector DB. Keep real hostnames, passwords, and SSH users in
# local env files only; do not copy them into memory docs.
VECTORDB_URL=
MCP_SERVER_URL=
MCP_UPSTREAM_API_KEY=
MCP_PRODUCT_ENABLED=false
COURTLISTENER_API_KEY=
COURTLISTENER_DB_USER=courtlistener
COURTLISTENER_DB_PASSWORD=CHANGE_ME_COURTLISTENER_DB_PASSWORD
COURTLISTENER_DB_NAME=courtlistener
# Keep both sidecar ports loopback-only. Remote embedding workers should use an
# authenticated SSH tunnel or a separately firewalled private-network design.
COURTLISTENER_DB_BIND=127.0.0.1
COURTLISTENER_DB_PORT=5434
COURTLISTENER_DB_HOST_FOR_JETSON=
COURTLISTENER_MCP_PORT=8021
COURTLISTENER_MCP_BIND=127.0.0.1
COURTLISTENER_MVP_STATES=ND,MT,MN,SD
COURTLISTENER_MVP_SPECIALTY=true
COURTLISTENER_MVP_SCOTUS=true
COURTLISTENER_SYNC_COURT_IDS=
COURTLISTENER_SYNC_BASELINE_START=2015-01-01
COURTLISTENER_SYNC_OVERLAP_HOURS=48
COURTLISTENER_SYNC_TIMEOUT_SECONDS=30
COURTLISTENER_SYNC_MAX_PAGES=
COURTLISTENER_SYNC_INTERVAL_SECONDS=86400
# Official legal-authority ingestion. Include a monitored operations address in
# the User-Agent so source operators can contact us about crawl behavior.
LEGAL_SOURCE_USER_AGENT=LegalApp-AuthoritySync/1.0 (mailto:operations@yourdomain.com)
LEGAL_AUTHORITY_SYNC_INTERVAL_SECONDS=86400
LEGAL_AUTHORITY_JOB_TIMEOUT_SECONDS=21600
LEGAL_AUTHORITY_USCODE_ENABLED=true
LEGAL_AUTHORITY_USCODE_TITLES=11,15,26,28,29,31,42
LEGAL_AUTHORITY_ECFR_ENABLED=true
LEGAL_AUTHORITY_ECFR_TITLES=26,42
LEGAL_AUTHORITY_CMS_ENABLED=true
LEGAL_AUTHORITY_BENEFITS_ENABLED=true
LEGAL_AUTHORITY_IRS_ENABLED=true
LEGAL_AUTHORITY_IRS_DAILY_LIMIT=12
LEGAL_AUTHORITY_OHIO_ENABLED=true
# ND adapter is implemented but remains off until its catalog access review is
# signed off. Setting true also requires a monitored ND crawler contact.
LEGAL_AUTHORITY_ND_ENABLED=false
OHIO_COURTS_CRAWLER_CONTACT=operations@yourdomain.com
OHIO_COURTS_AUTHORIZATION_BASIS=Direct crawl permission reported by the LegalApp operator; retain correspondence in the production compliance record
OHIO_COURT_CRAWL_DELAY_SECONDS=2
OHIO_COURT_MAX_DOWNLOAD_BYTES=52428800
ND_AUTHORITY_CRAWLER_CONTACT=operations@yourdomain.com
ND_AUTHORITY_CRAWL_DELAY_SECONDS=2
CLOUD_RETRIEVAL_PLANNER_TIMEOUT_SECONDS=3

# OAuth callback URIs — must match exactly what you register in each provider:
#
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
#   Authorized redirect URI: https://yourdomain.com/api/auth/google/callback
#
# Microsoft Entra → App Registrations → your app → Authentication
#   Redirect URI (Web): https://yourdomain.com/api/auth/microsoft/callback
#   Redirect URI (Web): https://yourdomain.com/api/integrations/microsoft/callback
#   Supported account types: Accounts in any organizational directory + personal Microsoft accounts
#   API permissions: User.Read (delegated, granted)
#
# Office NAA app registration (Single-page application redirects):
#   brk-multihub://yourdomain.com
#   https://yourdomain.com/office/index.html
# Expose api://<OFFICE_ENTRA_CLIENT_ID>/office.access as a delegated scope and
# pre-authorize the same client ID for that scope.
#
# Zoom App Marketplace → OAuth app → Redirect URL
#   Redirect URI: https://yourdomain.com/api/integrations/zoom/callback
ZOOM_REQUIRED_TENANT_ID=00000000-0000-4000-8000-000000000001
ZOOM_REQUIRED_TENANT_PLAN=intake-only

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...            # Flat-seat subscription Price ID from Stripe Dashboard
STRIPE_MCP_METER_EVENT_NAME=mcp_product_key_calls
STRIPE_SUCCESS_URL=https://yourdomain.com/billing?success=1
STRIPE_CANCEL_URL=https://yourdomain.com/billing?cancel=1

# Storage
# Container path plus one explicit absolute host bind shared by every production
# topology and by the backup/restore workflow.
UPLOAD_DIR=/app/uploads
UPLOADS_HOST_DIR=/srv/legalapp/uploads
HOST_STATUS_HOST_DIR=/srv/legalapp/host-status
HOST_DISK_STATUS_FILE=/run/legalapp-host-status/disk-status.json
HEALTH_HOST_DISK_MAX_AGE_SECONDS=180
MAX_FILE_SIZE_MB=50

# Backup, readiness and alert thresholds
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
OFFSITE_BACKUP_REQUIRED=true
# Pinned public half of the dedicated off-host restore-evidence signing key.
# Required when RESTIC_REPOSITORY is empty; keep its private half off the VPS.
OFFSITE_RESTORE_PUBLIC_KEY_FILE=/home/varta/.config/legalapp/offsite-restore-public.pem
ALERT_WEBHOOK_URL=
# Preflight preserves five GiB of build headroom beyond the free space needed
# to keep df strictly below this runtime threshold.
DISK_PATH=/
DISK_MAX_PERCENT=85
SCHEDULER_MAX_AGE_MINUTES=5
QUEUE_MAX_AGE_MINUTES=15
TLS_MIN_VALID_DAYS=14

# Optional remote-wrapper metadata. scripts/deploy_prod.sh itself runs on the
# checked-out Linux host and does not read these VPS_* values.
VPS_HOST=your.vps.ip.address
VPS_USER=deploy
VPS_APP_DIR=/home/deploy/legalapp
VPS_SSH_PORT=22
VPS_DB_URL=postgresql+asyncpg://legalapp:CHANGE_ME_OWNER_PASSWORD@postgres:5432/legalapp
GIT_BRANCH=main

# ── Hypervisor deployment/local lab access ───────────────────────────────────
# Keep real hostnames, users, ports, app paths, and Docker API URLs only in
# local env files. Memory/docs should reference these names rather than values.
HYPERVISOR_HOST=
HYPERVISOR_USER=
HYPERVISOR_APP_DIR=
HYPERVISOR_COMPOSE_FILE=docker-compose.hypervisor.yml
HYPERVISOR_PUBLIC_URL=
HYPERVISOR_SSH_PORT=22
DOCKER_HOST=
LOCAL_API_URL=
OAUTH_TUNNEL_LOCAL_PORT=8080

# ── On-prem (used by sync_to_vps.sh) ─────────────────────────────────────────
LOCAL_DB_URL=postgresql://legalapp:legalapp@localhost:5432/legalapp

# ── Optional read-only legacy SQL Server inspection/import tooling ───────────
# Used only by backend/scripts/inspect_legacy_sqlserver.py. Prefer a read-only
# SQL login. Never commit real customer values.
LEGACY_SQLSERVER_HOST=100.x.y.z,1433
LEGACY_SQLSERVER_DATABASE=LegacyIntake
LEGACY_SQLSERVER_USER=readonly
LEGACY_SQLSERVER_PASSWORD=
LEGACY_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
LEGACY_SQLSERVER_ENCRYPT=yes
LEGACY_SQLSERVER_TRUST_CERT=yes
LEGACY_TABS3_HOST=
LEGACY_TABS3_ROOT=
LEGACY_TABS3_DATABASE_PATH=
LEGACY_TABS3_SERVER_ENDPOINT=

# ── Jetson embedding cluster ──────────────────────────────────────────────────
JETSON_HOSTS=
JETSON_0_HOST=
JETSON_1_HOST=
JETSON_2_HOST=
JETSON_3_HOST=
JETSON_USER=jetson
JETSON_0_USER=
JETSON_1_USER=
JETSON_2_USER=
JETSON_3_USER=
# Automation uses SSH keys. Do not set Jetson passwords unless a one-off manual
# setup step explicitly needs them, and never commit real values.
JETSON_3_PASSWORD=
JETSON_SCRIPT_DIR=/data/legalapp-embeddings/scripts
JETSON_DB_REVERSE_TUNNEL=false
JETSON_DB_TUNNEL_REMOTE_PORT_BASE=15434
BATCH_SIZE=32
