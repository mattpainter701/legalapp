# ── Production environment — copy to .env.prod, never commit real values ──────

# Database (local VPS postgres — not exposed externally)
# Add ?ssl=require for off-host Postgres (managed DB services, separate server).
# For Docker-local Postgres (same host), ssl is optional but recommended.
DATABASE_URL=postgresql+asyncpg://legalapp:STRONG_PASS@localhost:5432/legalapp?ssl=require
# Redis: use rediss:// (TLS) for off-host Redis (Redis Cloud, ElastiCache, etc.)
# For Docker-local Redis (same host) plain redis:// is acceptable but set a strong password.
# rediss://:REDIS_PASS@localhost:6380 for TLS
REDIS_URL=redis://:REDIS_PASS@localhost:6379
REDIS_PASSWORD=STRONG_REDIS_PASS

# App
SECRET_KEY=generate-with-openssl-rand-hex-64
FRONTEND_URL=https://yourdomain.com
# In prod behind nginx, backend and frontend share the same domain
BACKEND_URL=https://yourdomain.com
DOMAIN=yourdomain.com

# Token encryption — for storing OAuth refresh tokens at rest (Fernet symmetric key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://yourdomain.com/api/integrations/zoom/callback
ZOOM_WEBHOOK_SECRET_TOKEN=
# Zoom Phone Server-to-Server OAuth app for call-history ingestion.
# Scope set should include current Call History/Call Element read scopes plus
# recording/transcript read scopes selected in the Zoom app UI.
ZOOM_PHONE_CLIENT_ID=
ZOOM_PHONE_CLIENT_SECRET=
ZOOM_PHONE_ACCOUNT_ID=
ZOOM_PHONE_SCOPES=phone:read:list_call_logs:admin phone:read:call_log:admin phone:read:list_call_recordings:admin phone:read:call_recording:admin phone:read:recording_transcript:admin
TEAMS_APP_ID=b7aef9aa-6b66-4cde-8cf8-4a251e2f8f22

# AI APIs
OPENAI_API_KEY=sk-...              # For Phase 1 embeddings + query embedding
DEEPSEEK_API_KEY=                  # Primary LLM
ANTHROPIC_API_KEY=sk-ant-...       # Premium tier (Claude Opus 4)

# LLM model names — update when DeepSeek V4 Flash releases
PRIMARY_LLM=deepseek-chat
PREMIUM_LLM=claude-opus-4-8

# LiteLLM Gateway — primary LLM router when enabled
LITELLM_ENABLED=true
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-litellm-master-key
LITELLM_DB_PASSWORD=STRONG_LITELLM_DB_PASS
LITELLM_DATABASE_URL=postgresql://litellm:STRONG_LITELLM_DB_PASS@litellm-postgres:5432/litellm
LITELLM_STANDARD_MODEL=clarity-standard
LITELLM_PREMIUM_MODEL=clarity-premium

# Dev mode MUST be false in production
DEV_MODE=false

# Platform super-admin key (generate with: openssl rand -hex 32)
# Keep secret — grants cross-tenant visibility
PLATFORM_SECRET_KEY=   # Generate: openssl rand -hex 32

# Optional: separate vectorDB for CourtListener public_chunks (BGE-384).
# Leave empty to use the main DATABASE_URL.
VECTORDB_URL=

# OAuth callback URIs — must match exactly what you register in each provider:
#
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
#   Authorized redirect URI: https://yourdomain.com/api/auth/google/callback
#
# Microsoft Entra → App Registrations → your app → Authentication
#   Redirect URI (Web): https://yourdomain.com/api/auth/microsoft/callback
#   Redirect URI (Web): https://yourdomain.com/api/integrations/microsoft/callback
#   Supported account types: Accounts in any organizational directory + personal Microsoft accounts
#   API permissions: User.Read (delegated, granted)
#
# Zoom App Marketplace → OAuth app → Redirect URL
#   Redirect URI: https://yourdomain.com/api/integrations/zoom/callback

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...            # Flat-seat subscription Price ID from Stripe Dashboard
STRIPE_SUCCESS_URL=https://yourdomain.com/billing?success=1
STRIPE_CANCEL_URL=https://yourdomain.com/billing?cancel=1

# Storage
UPLOAD_DIR=/data/legalapp/uploads
MAX_FILE_SIZE_MB=50

# ── VPS deployment (used by deploy_prod.sh) ───────────────────────────────────
VPS_HOST=your.vps.ip.address
VPS_USER=deploy
VPS_APP_DIR=/home/deploy/legalapp
VPS_SSH_PORT=22
VPS_DB_URL=postgresql+asyncpg://legalapp:STRONG_PASS@localhost:5432/legalapp
GIT_BRANCH=main

# ── On-prem (used by sync_to_vps.sh) ─────────────────────────────────────────
LOCAL_DB_URL=postgresql://legalapp:legalapp@localhost:5432/legalapp

# ── Optional read-only legacy SQL Server inspection/import tooling ───────────
# Used only by backend/scripts/inspect_legacy_sqlserver.py. Prefer a read-only
# SQL login. Never commit real customer values.
LEGACY_SQLSERVER_HOST=100.x.y.z,1433
LEGACY_SQLSERVER_DATABASE=LegacyIntake
LEGACY_SQLSERVER_USER=readonly
LEGACY_SQLSERVER_PASSWORD=
LEGACY_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
LEGACY_SQLSERVER_ENCRYPT=yes
LEGACY_SQLSERVER_TRUST_CERT=yes

# ── Jetson embedding cluster ──────────────────────────────────────────────────
JETSON_0_HOST=192.168.1.101
JETSON_1_HOST=192.168.1.102
JETSON_2_HOST=192.168.1.103
JETSON_USER=jetson
JETSON_SCRIPT_DIR=/home/jetson/legalapp/scripts
BATCH_SIZE=256
