DATABASE_URL=postgresql+asyncpg://legalapp:legalapp@postgres:5432/legalapp
REDIS_URL=redis://redis:6379
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# In dev (docker compose): FRONTEND_URL is where the browser opens the app.
# In prod: set to your public domain, e.g. https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# BACKEND_URL is where OAuth providers redirect after login.
# In dev: http://localhost:8000  (hits FastAPI directly — register this URI in
#         Google Cloud Console and Azure App Registration)
# In prod behind nginx: same as FRONTEND_URL (e.g. https://yourdomain.com)
BACKEND_URL=http://localhost:8000

UPLOAD_DIR=/app/uploads

# Email notifications (set EMAIL_ENABLED=true in prod)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@clarity.legal

# Slack notifications (optional)
SLACK_WEBHOOK_URL=

# Dev mode — enables /api/dev/* endpoints (NEVER true in prod)
DEV_MODE=true

# LLM — update when DeepSeek V4 Flash ships
PRIMARY_LLM=deepseek-chat
PREMIUM_LLM=claude-opus-4-8
