<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI for the LawHand file share agent (WiX Toolset v5).

  Installs a single self-contained exe into Program Files, registers it as an
  auto-starting Windows service, and creates the machine-wide data directory
  the agent keeps its config, key and ledger in.

  Build:  wix build lawhand-agent.wxs -arch x64 -d AgentExe=..\..\dist\lawhand-agent.exe -d ProductVersion=0.15.2 -ext WixToolset.Util.wixext -o lawhand-agent.msi

  Install or over-top upgrade (pair separately with `lawhand-agent register`):
      msiexec /i lawhand-agent-0.15.2-x64.msi /qn /norestart

  Run the service as a domain account instead of LocalSystem (only needed when
  shares are mounted with the machine's own identity rather than a credential
  stored in the tenant vault):
      msiexec /i ... SERVICE_ACCOUNT=CORP\svc-lawhand SERVICE_PASSWORD=...
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="LawHand File Share Agent"
           Manufacturer="LawHand"
           Version="$(ProductVersion)"
           UpgradeCode="d3f674f5-b516-4ecc-b82d-b2495b4aa260"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="On-premise file share indexing agent for LawHand" />

    <!-- Keep RemoveExistingProducts late: the old service must remain present
         until the replacement product has installed.  This is required for a
         password-backed custom service account because Windows Installer and
         SCM do not expose the old password after the service is deleted.
         Do not move this earlier without a password reacquisition flow. -->
    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of the LawHand File Share Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Keep an explicit command-line SERVICE_ACCOUNT authoritative. When it
         is omitted, AppSearch discovers the existing SCM identity and the
         SetProperty actions below select it before costing; LocalSystem is
         only the clean-install fallback. No password is read or persisted. -->
    <Property Id="SERVICE_ACCOUNT" Secure="yes" />
    <Property Id="EXISTING_SERVICE_ACCOUNT">
      <RegistrySearch Id="ExistingLawHandServiceAccount"
                      Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\LawHandAgent"
                      Name="ObjectName"
                      Type="raw" />
    </Property>
    <Property Id="SERVICE_PASSWORD" Secure="yes" Hidden="yes" />

    <SetProperty Id="SERVICE_ACCOUNT"
                 Action="SetServiceAccountFromExisting"
                 Value="[EXISTING_SERVICE_ACCOUNT]"
                 After="AppSearch"
                 Sequence="both"
                 Condition="NOT SERVICE_ACCOUNT AND EXISTING_SERVICE_ACCOUNT" />
    <SetProperty Id="SERVICE_ACCOUNT"
                 Action="SetServiceAccountDefault"
                 Value="LocalSystem"
                 Before="CostInitialize"
                 Sequence="both"
                 Condition="NOT SERVICE_ACCOUNT" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="COMPANYFOLDER" Name="LawHand">
        <Directory Id="INSTALLFOLDER" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATACOMPANYFOLDER" Name="LawHand">
        <Directory Id="DATAFOLDER" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="LawHand File Share Agent" Level="1">
      <ComponentGroupRef Id="AgentComponents" />
    </Feature>

  </Package>

  <Fragment>
    <ComponentGroup Id="AgentComponents">
      <!-- Keep these component identities stable across releases. A late
           major upgrade updates the still-present service component, while
           the data component is deliberately permanent. -->
      <!-- Guid is intentionally omitted. WiX derives a stable component GUID
           from the key path; changing it would strand existing installs. -->
      <Component Id="AgentExeComponent" Directory="INSTALLFOLDER">
        <File Id="LawHandAgentExe"
              Name="lawhand-agent.exe"
              Source="$(AgentExe)"
              KeyPath="yes" />

        <ServiceInstall Id="LawHandAgentService"
                        Name="LawHandAgent"
                        DisplayName="LawHand File Share Agent"
                        Description="Indexes approved on-premise file shares and relays document text to LawHand on request."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Arguments="service run"
                        Account="[SERVICE_ACCOUNT]"
                        Password="[SERVICE_PASSWORD]"
                        Vital="yes">
          <!-- Use the stable service SID for local file access. This remains
               present in the process token even when the service logs on as a
               domain or local account, and avoids persisting that account's
               password merely to re-apply ACLs during an upgrade. -->
          <ServiceConfig ServiceSid="unrestricted"
                         OnInstall="yes"
                         OnReinstall="yes" />
          <!-- A file server reboot or a transient network outage should not
               leave the share un-indexed until someone notices. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60"
                              ResetPeriodInDays="1" />
        </ServiceInstall>

        <ServiceControl Id="LawHandAgentServiceControl"
                        Name="LawHandAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <Component Id="DataFolderComponent" Directory="DATAFOLDER" Permanent="yes">
        <CreateFolder>
          <!-- Config contains the API key. Grant only the stable service SID,
               LocalSystem and local administrators; do not inherit the broad
               ProgramData ACL. -->
          <util:PermissionEx User="SYSTEM" GenericAll="yes" Inheritable="yes" />
          <util:PermissionEx User="Administrators" GenericAll="yes" Inheritable="yes" />
          <util:PermissionEx Domain="NT SERVICE"
                             User="LawHandAgent"
                             GenericAll="yes"
                             Inheritable="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM"
                       Key="Software\LawHand\Agent"
                       Name="DataFolder"
                       Type="string"
                       Value="[DATAFOLDER]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Fragment>
</Wix>
