{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lawhand-inbound-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "BACKEND_INGEST_URL": "https://getlawhand.com/api/inbound-email/cloudflare",
    "INBOUND_EMAIL_DOMAIN": "intake.getlawhand.com",
    "MAX_EMAIL_BYTES": "26214400"
  }
}
