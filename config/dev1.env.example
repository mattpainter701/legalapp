# Copy to /home/varta/.config/lawhand/dev1.env on Skynet (mode 600).
# Never commit real values. Dev1 uses distinct credentials and empty/synthetic
# data; do not copy the production DATABASE_URL, token keys, or OAuth secrets.
APP_ENV_FILE=/home/varta/.config/lawhand/dev1.env
DEPLOYMENT_ROLE=dev1
DOMAIN=dev1.getlawhand.com
VITE_PUBLIC_SITE_URL=https://dev1.getlawhand.com
VITE_CONTACT_URL=mailto:support@getlawhand.com
PUBLIC_SIGNUP_ENABLED=false
EMAIL_ENABLED=false
EMAIL_FROM=dev1-no-reply@getlawhand.com
WORKSPACE_MCP_ENABLED=false
MCP_PRODUCT_ENABLED=false
RUN_SCHEDULER=false

POSTGRES_PASSWORD=replace-with-dev1-only-secret
CLARITY_APP_PASSWORD=replace-with-a-different-dev1-only-secret
DATABASE_URL=postgresql+asyncpg://clarity_app:replace-with-a-different-dev1-only-secret@postgres:5432/legalapp
APP_DATABASE_URL=postgresql+asyncpg://clarity_app:replace-with-a-different-dev1-only-secret@postgres:5432/legalapp
MIGRATOR_DATABASE_URL=postgresql+asyncpg://legalapp:replace-with-dev1-only-secret@postgres:5432/legalapp
REDIS_PASSWORD=replace-with-dev1-only-secret
REDIS_URL=redis://:replace-with-dev1-only-secret@redis:6379/0

LITELLM_DB_PASSWORD=replace-with-dev1-only-secret
LITELLM_DATABASE_URL=postgresql://litellm:replace-with-dev1-only-secret@litellm-postgres:5432/litellm
LITELLM_API_KEY=replace-with-dev1-only-secret
LITELLM_SALT_KEY=replace-with-permanent-dev1-only-secret

SECRET_KEY=replace-with-dev1-only-secret
TOKEN_ENCRYPTION_KEY=replace-with-dev1-only-fernet-key
PLATFORM_ADMIN_KEY=replace-with-dev1-only-secret

UPLOADS_HOST_DIR=/home/varta/lawhand-dev1-data/uploads
HOST_STATUS_HOST_DIR=/home/varta/lawhand-dev1-data/status
DEV1_ORIGIN_TLS_HOST_DIR=/home/varta/legalapp/nginx/ssl
DEV1_WEBROOT_HOST_DIR=/home/varta/lawhand-dev1-data/webroot
ORIGIN_TLS_SERVER_NAME=origin.getlawhand.internal
ORIGIN_TLS_CA_FILE=/etc/cloudflared/lawhand-origin-ca.pem

# Add only non-production provider credentials needed for feature testing.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
