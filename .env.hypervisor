# ── Infrastructure ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://legalapp:legalapp@postgres:5432/legalapp
REDIS_URL=redis://redis:6379
SECRET_KEY=change-this-to-a-long-random-secret-key-managed-outside-git
UPLOAD_DIR=/app/uploads

# ── URLs ──────────────────────────────────────────────────────────────────────
# Access via SSH tunnel on your dev machine:
#   ssh -L 8080:localhost:80 varta@172.16.16.202 -N
#   Browse: http://localhost:8080
# Register OAuth callbacks as:
#   http://localhost:8080/api/auth/google/callback
#   http://localhost:8080/api/auth/microsoft/callback
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080

# ── LLM (OpenCode.ai) ────────────────────────────────────────────────────────
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
DEEPSEEK_API_KEY=                      # TODO: OpenCode.ai key from opencode.ai dashboard
PRIMARY_LLM=deepseek-v4-flash
PREMIUM_LLM=deepseek-v4-pro
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=                    # TODO: from openrouter.ai/keys

# ── Platform admin ────────────────────────────────────────────────────────────
PLATFORM_SECRET_KEY=change-this-to-a-long-random-platform-key-managed-outside-git

# ── Billing (Stripe) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/billing?success=1
STRIPE_CANCEL_URL=http://localhost:3000/billing?cancel=1

# ── Email ──────────────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@clarity.legal

# ── OAuth SSO ──────────────────────────────────────────────────────────────────
# Fill these in after copying this template to .env
GOOGLE_CLIENT_ID=                      # TODO: from console.cloud.google.com
GOOGLE_CLIENT_SECRET=                  # TODO
MICROSOFT_CLIENT_ID=                   # TODO: from portal.azure.com
MICROSOFT_CLIENT_SECRET=               # TODO
MICROSOFT_TENANT_ID=common

# ── Other ──────────────────────────────────────────────────────────────────────
VECTORDB_URL=
SLACK_WEBHOOK_URL=
DEV_MODE=false
