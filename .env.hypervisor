# ── Infrastructure ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://legalapp:legalapp@postgres:5432/legalapp
# Optional runtime override for least-privilege cutover.
# APP_DATABASE_URL=postgresql+asyncpg://clarity_app:STRONG_PASS@postgres:5432/legalapp
REDIS_URL=redis://redis:6379
SECRET_KEY=change-this-to-a-long-random-secret-key-managed-outside-git
UPLOAD_DIR=/app/uploads
HOST_STATUS_HOST_DIR=/srv/legalapp/host-status
HOST_DISK_STATUS_FILE=/run/legalapp-host-status/disk-status.json
HEALTH_HOST_DISK_MAX_AGE_SECONDS=180
BACKUP_STATUS_FILE=/run/legalapp-host-status/backup-status.json
# The hourly timer has a bounded randomized delay. Readiness fails closed if
# no complete encrypted off-site snapshot has succeeded within two hours.
HEALTH_BACKUP_MAX_AGE_SECONDS=7200
# Fail closed: readiness will not report healthy without off-site evidence.
OFFSITE_BACKUP_REQUIRED=true

# ── URLs ──────────────────────────────────────────────────────────────────────
# Production (behind Cloudflare Tunnel):
#   https://getlawhand.com
# Register OAuth callbacks as:
#   https://getlawhand.com/api/auth/google/callback
#   https://getlawhand.com/api/auth/microsoft/callback
DOMAIN=getlawhand.com
FRONTEND_URL=https://getlawhand.com
BACKEND_URL=https://getlawhand.com
VITE_PUBLIC_SITE_URL=https://getlawhand.com
VITE_CONTACT_URL=mailto:support@getlawhand.com

# ── LiteLLM Gateway ──────────────────────────────────────────────────────────
# Master key must start with 'sk-'. Backend and LiteLLM container must use the same value.
LITELLM_ENABLED=true
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-local-litellm       # TODO: change to a strong random key in prod
LITELLM_DB_PASSWORD=litellm
LITELLM_DATABASE_URL=postgresql://litellm:litellm@litellm-postgres:5432/litellm
LITELLM_STANDARD_MODEL=clarity-standard
LITELLM_PREMIUM_MODEL=clarity-premium

# ── LLM (OpenCode.ai) ────────────────────────────────────────────────────────
DEEPSEEK_BASE_URL=https://opencode.ai/go/v1
DEEPSEEK_API_KEY=                      # TODO: OpenCode.ai key from opencode.ai dashboard
PRIMARY_LLM=deepseek-v4-flash
PREMIUM_LLM=deepseek-v4-pro
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=                    # TODO: from openrouter.ai/keys

# ── Platform admin ────────────────────────────────────────────────────────────
PLATFORM_SECRET_KEY=
PLATFORM_LEGACY_BOOTSTRAP_ENABLED=false

# ── Billing (Stripe) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=https://getlawhand.com/billing?success=1
STRIPE_CANCEL_URL=https://getlawhand.com/billing?cancel=1

# ── Email ──────────────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=matt@cybersafeadvisor.com
MARKETING_LEAD_EMAIL=support@getlawhand.com
MARKETING_LEAD_EMAIL=support@getlawhand.com

# ── OAuth SSO ──────────────────────────────────────────────────────────────────
# Fill these in after copying this template to .env
GOOGLE_CLIENT_ID=                      # TODO: from console.cloud.google.com
GOOGLE_CLIENT_SECRET=                  # TODO
MICROSOFT_CLIENT_ID=519fcd90-06ba-4563-8d0d-c479df468b26  # from portal.azure.com
MICROSOFT_CLIENT_SECRET=               # TODO
MICROSOFT_TENANT_ID=common               # accepts org + personal MS accounts
OFFICE_ASSISTANT_ENABLED=false
# Comma-separated Clarity tenant UUIDs. Empty keeps the pilot closed.
OFFICE_ASSISTANT_PILOT_TENANT_IDS=
OFFICE_ENTRA_CLIENT_ID=
OFFICE_ENTRA_API_AUDIENCE=
OFFICE_ENTRA_REQUIRED_SCOPE=office.access
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://getlawhand.com/api/integrations/zoom/callback
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_PHONE_REDIRECT_URI=https://getlawhand.com/api/integrations/zoom-phone/callback
ZOOM_PHONE_CLIENT_ID=
ZOOM_PHONE_CLIENT_SECRET=
ZOOM_PHONE_ACCOUNT_ID=
ZOOM_PHONE_SCOPES=phone:read:list_call_logs:admin phone:read:call_log:admin phone:read:list_call_recordings:admin phone:read:call_recording:admin phone:read:recording_transcript:admin

# ── Other ──────────────────────────────────────────────────────────────────────
VECTORDB_URL=
SLACK_WEBHOOK_URL=
DEV_MODE=false
