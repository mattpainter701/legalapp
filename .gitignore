# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Frontend
node_modules/
dist/
.vite/
package-lock.json
!frontend/package-lock.json

# Env / secrets
.env
.env.prod
*.env
.env.*
!.env.hypervisor     # tracked template — no real secrets, safe to commit

# Claude Code session memory (local only)
memory/
.claude/
.claude/worktrees/

# OS
.DS_Store
Thumbs.db

# Uploads (runtime data)
uploads/

# SSL certs and Let's Encrypt data — never commit private keys
nginx/ssl/*.pem
nginx/ssl/*.key
nginx/letsencrypt/
nginx/webroot/

# Backups / logs
backups/
*.dump
*.dump.gz
/var/log/clarity-legal/

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# Agent worktrees
.claude/worktrees/

# Superpowers brainstorm mockups (local only)
.superpowers/
